NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/obts
CLIENT_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# Forgot-password email (nodemailer SMTP). Leave blank to keep the previous
# console-only behavior for the reset link.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS= # app password, not the login password
MAIL_FROM=eYatra <no-reply@eyatra.dev>
MOCK_PAYMENT_GATEWAY=true
